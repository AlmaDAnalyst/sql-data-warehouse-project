/*
===============================================================================
Quality Checks
===============================================================================
Script Purpose:
    This script performs various quality checks for data consistency, accuracy, 
    and standardization across the 'silver' layer. It includes checks for:
    - Null or duplicate primary keys.
    - Unwanted spaces in string fields.
    - Data standardization and consistency.
    - Invalid date ranges and orders.
    - Data consistency between related fields.

Usage Notes:
    - Run these checks after data loading Silver Layer.
    - Investigate and resolve any discrepancies found during the checks.
===============================================================================
*/

-- ====================================================================
-- Checking 'silver.crm_cust_info'
-- ====================================================================
-- Check for NULLS or DUPLICATES in Primary Key
-- Expectation: No Results
-- A Primary Key must be unique and NOT NULL (Quality Check)
SELECT cst_id, COUNT(*) 
FROM dwh_bronze.crm_cust_info
GROUP BY cst_id
HAVING COUNT(*) > 1 OR cst_id IS NULL;

-- Check for unwanted spaces in string values (Quality Check)
-- Expectation: No Results
SELECT cst_firstname
FROM dwh_bronze.crm_cust_info
WHERE cst_firstname != TRIM(cst_firstname);

SELECT cst_lastname
FROM dwh_bronze.crm_cust_info
WHERE cst_lastname != TRIM(cst_lastname);

-- Check the consistency of values in low cardinality columns (Quality Check)
-- Data Standardization & Consistency
SELECT DISTINCT cst_marital_status
FROM dwh_bronze.crm_cust_info;

SELECT DISTINCT cst_gndr
FROM dwh_bronze.crm_cust_info;


-- ====================================================================
-- Checking 'silver.crm_prd_info'
-- ====================================================================
-- Check for NULLS or DUPLICATES in Primary Key
-- Expectation: No Results
-- A Primary Key must be unique and NOT NULL (Quality Check)
SELECT prd_id, COUNT(*) 
FROM dwh_silver.crm_prd_info
GROUP BY prd_id
HAVING COUNT(*) > 1 OR prd_id IS NULL;

-- filtering out unmatched data after applying transformation
SELECT
prd_key,
REPLACE(SUBSTRING(prd_key, 1, 5), '-', '_') AS cat_id
FROM dwh_bronze.crm_prd_info
WHERE REPLACE(SUBSTRING(prd_key, 1, 5), '-', '_') NOT IN
(SELECT DISTINCT id FROM dwh_bronze.erp_px_cat_g1v2);

SELECT
prd_key,
REPLACE(SUBSTRING(prd_key, 1, 5), '-', '_') AS cat_id,
SUBSTRING(prd_key, 7, LENGTH(prd_key)) AS prd_key
FROM dwh_bronze.crm_prd_info
WHERE SUBSTRING(prd_key, 7, LENGTH(prd_key)) IN
(SELECT sls_prd_key FROM dwh_bronze.crm_sales_details);

-- Check for unwanted spaces
-- Expectation: No Results
SELECT prd_nm
FROM dwh_silver.crm_prd_info
WHERE prd_nm != TRIM(prd_nm);

-- Check for BLANKS, NULLS or Negative Numbers
-- Expectation: No Results
SELECT prd_cost
FROM dwh_silver.crm_prd_info
WHERE prd_cost < 0 OR prd_cost IS NULL;

-- Data Standardization & Consistency
SELECT DISTINCT prd_line
FROM dwh_silver.crm_prd_info;

-- Check for INVALID Date Orders
SELECT *
FROM dwh_silver.crm_prd_info
WHERE STR_TO_DATE(prd_end_dt, '%Y-%m-%d') < STR_TO_DATE(prd_start_dt, '%Y-%m-%d'); -- End date must not be earlier than the start date


-- ====================================================================
-- Checking 'silver.crm_sales_details'
-- ====================================================================
-- Check for unwanted spaces
-- Expectation: No Results
SELECT *
FROM dwh_bronze.crm_sales_details
WHERE sls_ord_num != TRIM(sls_ord_num);

SELECT *
FROM dwh_bronze.crm_sales_details
WHERE sls_prd_key NOT IN (SELECT prd_key FROM dwh_silver.crm_prd_info);

SELECT *
FROM dwh_bronze.crm_sales_details
WHERE sls_cust_id NOT IN (SELECT cst_id FROM dwh_silver.crm_cust_info);

-- Check for Invalid Dates
-- Check for Zero and Negative values
-- Checking for outliers by validating the boundaries of the date range (WHERE sls_order_dt >, <)
SELECT 
NULLIF(sls_due_dt, 0) AS sls_due_dt
FROM dwh_bronze.crm_sales_details
WHERE sls_due_dt <= 0 
OR LENGTH(sls_due_dt) != 8 
OR sls_due_dt > 20500101
OR sls_due_dt < 19000101;

-- Checking for Invalid Date Orders
SELECT *
FROM dwh_bronze.crm_sales_details
WHERE sls_order_dt > sls_ship_dt OR sls_order_dt > sls_due_dt;

-- Check Data Consistency: Between Sales, Quantity, and Price
-- >> Sales = Quantity * Price
-- >> Values must not be NULL, zero, or negative
SELECT DISTINCT
sls_sales, 
sls_quantity, 
sls_price,
FROM dwh_bronze.crm_sales_details
WHERE sls_sales != sls_quantity * sls_price
  OR sls_sales IS NULL 
  OR sls_quantity IS NULL 
  OR sls_price IS NULL
  OR sls_sales <= 0 
  OR sls_quantity <= 0  
  OR sls_price <= 0
ORDER BY sls_sales, sls_quantity, sls_price;


-- ====================================================================
-- Checking 'silver.erp_cust_az12'
-- ====================================================================
SELECT
cid,
	CASE
		WHEN cid LIKE 'NAS%' THEN SUBSTRING(cid, 4, LENGTH(cid))
		ELSE cid
	END AS cid, 
bdate,
gen
FROM dwh_bronze.erp_cust_az12
WHERE CASE WHEN cid LIKE 'NAS%' THEN SUBSTRING(cid, 4, LENGTH(cid))
		ELSE cid
END NOT IN (SELECT DISTINCT cst_key FROM dwh_silver.crm_cust_info);

-- Identify Out-of-Range Dates
SELECT DISTINCT bdate
FROM dwh_bronze.erp_cust_az12
WHERE bdate < '1924-01-01' OR bdate > curdate();

-- Data Standardization & Consistency
SELECT DISTINCT gen,
	CASE
		WHEN UPPER(TRIM(gen)) IN ('F', 'FEMALE') THEN 'Female'
        WHEN UPPER(TRIM(gen)) IN ('M', 'MALE') THEN 'Male'
        ELSE 'n/a'
	END AS gen
FROM dwh_bronze.erp_cust_az12;


-- ====================================================================
-- Checking 'silver.erp_loc_a101'
-- ====================================================================
-- Data Standardization & Consistency
SELECT DISTINCT cntry,
FROM dwh_bronze.erp_loc_a101
ORDER BY cntry;


-- ====================================================================
-- Checking 'silver.erp_px_cat_g1v2'
-- ====================================================================
-- Checking for unwanted spaces
SELECT *
FROM dwh_bronze.erp_px_cat_g1v2
WHERE cat != UPPER(TRIM(cat)) 
  OR subcat != UPPER(TRIM(subcat))
  OR maintenance != UPPER(TRIM(maintenance));

-- Data Standardization & Consistency
SELECT DISTINCT maintenance
FROM dwh_bronze.erp_px_cat_g1v2;
