/*
=============================================================================================
DDL Script: Create Bronze Tables
=============================================================================================
Script Purpose:
  This script creates tables in the 'bronze' schema(=~database), dropping existing tables
  if they already exist.
  Run this script to re-define the DDL structure of 'bronze' tables
=============================================================================================
*/


DROP TABLE IF EXISTS dwh_bronze.crm_cust_info;
CREATE TABLE dwh_bronze.crm_cust_info (
	cst_id INT,
	cst_key VARCHAR(50),
	cst_firstname VARCHAR(50),
	cst_lastname VARCHAR(50),
	cst_marital_status VARCHAR(50),
	cst_gndr VARCHAR(50),
	cst_create_date DATE
);

DROP TABLE IF EXISTS dwh_bronze.crm_prd_info;
CREATE TABLE dwh_bronze.crm_prd_info (
	prd_id INT,
	prd_key VARCHAR(50),
	prd_nm VARCHAR(100),
	prd_cost INT,
	prd_line VARCHAR(50),
	prd_start_dt VARCHAR(50),		# Use VARCHAR here to avoid import errors
	prd_end_dt VARCHAR(50)			# Handles the empty values in your CSV
);

DROP TABLE IF EXISTS dwh_bronze.crm_sales_details;
CREATE TABLE dwh_bronze.crm_sales_details (
	sls_ord_num VARCHAR(50),
	sls_prd_key VARCHAR(50),
	sls_cust_id INT,
	sls_order_dt INT,
	sls_ship_dt INT,
	sls_due_dt INT,
	sls_sales DECIMAL(15, 2),		# Changed from INT to support decimals
	sls_quantity INT,
	sls_price DECIMAL(15, 2)		# Changed from INT to support decimals
);

DROP TABLE IF EXISTS dwh_bronze.erp_cust_az12;
CREATE TABLE dwh_bronze.erp_cust_az12 (
	cid VARCHAR(50),
	bdate VARCHAR(50), 		# Change this from DATE to VARCHAR
	gen VARCHAR(50)
);

DROP TABLE IF EXISTS dwh_bronze.erp_loc_a101;
CREATE TABLE dwh_bronze.erp_loc_a101 (
	cid VARCHAR(50),
	cntry VARCHAR(50)
);

DROP TABLE IF EXISTS dwh_bronze.erp_px_cat_g1v2;
CREATE TABLE dwh_bronze.erp_px_cat_g1v2 (
	id VARCHAR(50),
	cat VARCHAR(50),
	subcat VARCHAR(50),
	maintenance VARCHAR(50)
);
