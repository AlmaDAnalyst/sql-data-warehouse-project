




DELIMITER $$
CREATE PROCEDURE dwh_silver.load_silver_layer()
BEGIN
    -- 1. Truncate all Silver tables to prepare for Full Load
    TRUNCATE TABLE dwh_silver.crm_cust_info;
    TRUNCATE TABLE dwh_silver.crm_prd_info;
    TRUNCATE TABLE dwh_silver.crm_sales_details;
    TRUNCATE TABLE dwh_silver.erp_loc_a101;
    TRUNCATE TABLE dwh_silver.erp_cust_az12;
    TRUNCATE TABLE dwh_silver.erp_px_cat_g1v2;

	INSERT INTO dwh_silver.crm_cust_info (
		cst_id,
		cst_key,
		cst_firstname,
		cst_lastname,
		cst_marital_status,
		cst_gndr,
		cst_create_date)

	SELECT
		CASE 
			WHEN cst_id = 0 OR cst_id = '' THEN NULL 
			ELSE cst_id 
		END AS cst_id, -- Handling the MySQL "Zero ID" issue
		cst_key,
		TRIM(cst_firstname) AS cst_firstname,
		TRIM(cst_lastname) AS cst_lastname,
		CASE 
			WHEN UPPER(TRIM(cst_marital_status)) = 'S' THEN 'Single'
			WHEN UPPER(TRIM(cst_marital_status)) = 'M' THEN 'Married'
			ELSE 'n/a'
		END cst_marital_status, -- Normalize marital status values to readable format
		CASE 
			WHEN UPPER(TRIM(cst_gndr)) = 'F' THEN 'Female'
			WHEN UPPER(TRIM(cst_gndr)) = 'M' THEN 'Male'
			ELSE 'n/a'
		END cst_gndr, -- Normalize gender values to readable format
		STR_TO_DATE(cst_create_date, '%m/%d/%Y') AS cst_create_date -- Date conversion from the raw Bronze string
	FROM
	(
		SELECT *,
		ROW_NUMBER() OVER (PARTITION BY cst_id ORDER BY STR_TO_DATE(cst_create_date, '%m/%d/%Y') DESC) AS flag_last
		FROM dwh_bronze.crm_cust_info
		WHERE cst_id <> '0' AND cst_id <> '' AND cst_id IS NOT NULL
	) dplct 
	WHERE flag_last = 1;



	INSERT INTO dwh_silver.crm_prd_info (
		prd_id,
		cat_id,
		prd_key,
		prd_nm,
		prd_cost,
		prd_line,
		prd_start_dt,
		prd_end_dt)
		
	SELECT
		prd_id,
		REPLACE(SUBSTRING(prd_key, 1, 5), '-', '_') AS cat_id,  -- Extract category ID
		SUBSTRING(prd_key, 7, LENGTH(prd_key)) AS prd_key,		-- Extract product key
		prd_nm,
		-- 1. NULLIF turns the blank '' into a true NULL
		-- 2. COALESCE turns that NULL into a 0
		COALESCE(NULLIF(prd_cost, ''), 0) AS prd_cost,
		CASE UPPER(TRIM(prd_line))
			WHEN 'M' THEN 'Mountain'
			WHEN 'R' THEN 'Road'
			WHEN 'S' THEN 'Other Sales'
			WHEN 'T' THEN 'Touring'
			ELSE 'n/a'
		END AS prd_line, -- Map product line codes to descriptive values
		STR_TO_DATE(prd_start_dt, '%Y-%m-%d') AS prd_start_dt, -- Convert the string to a real date first
		DATE_SUB(
			LEAD(STR_TO_DATE(prd_start_dt, '%Y-%m-%d')) 
				OVER (PARTITION BY prd_key ORDER BY STR_TO_DATE(prd_start_dt, '%Y-%m-%d')), 
			INTERVAL 1 DAY
		) AS prd_end_dt -- Calculate end date as one day before the next start date
	FROM dwh_bronze.crm_prd_info;



	INSERT INTO dwh_silver.crm_sales_details (
		sls_ord_num,
		sls_prd_key,
		sls_cust_id,
		sls_order_dt,
		sls_ship_dt,
		sls_due_dt,
		sls_sales,
		sls_quantity,
		sls_price)
		
	WITH fixed_price_cte AS (
		SELECT 
			*,
			-- Step 1: Derive/Fix Price and handle negatives (Rule 2 & 3)
			CASE 
				WHEN sls_price IS NULL OR sls_price <= 0 THEN NULLIF(sls_sales / NULLIF(sls_quantity, 0), 0)
				ELSE ABS(sls_price) 
			END AS derived_price
		FROM dwh_bronze.crm_sales_details
	)
	SELECT
		sls_ord_num,
		sls_prd_key,
		sls_cust_id,
		CASE 
			WHEN sls_order_dt = 0 OR LENGTH(sls_order_dt) != 8 THEN NULL
			ELSE STR_TO_DATE(CAST(sls_order_dt AS CHAR), '%Y%m%d')
		END AS sls_order_dt,
		CASE 
			WHEN sls_ship_dt = 0 OR LENGTH(sls_ship_dt) != 8 THEN NULL
			ELSE STR_TO_DATE(CAST(sls_ship_dt AS CHAR), '%Y%m%d')
		END AS sls_ship_dt,
		CASE 
			WHEN sls_due_dt = 0 OR LENGTH(sls_due_dt) != 8 THEN NULL
			ELSE STR_TO_DATE(CAST(sls_due_dt AS CHAR), '%Y%m%d')
		END AS sls_due_dt,
		-- Step 2: Use the derived_price to fix Sales (Rule 1)
		CASE 
			WHEN sls_sales IS NULL OR sls_sales <= 0 OR sls_sales != sls_quantity * derived_price THEN sls_quantity * derived_price
			ELSE sls_sales 
		END AS sls_sales,
		sls_quantity,
		derived_price AS sls_price
	FROM fixed_price_cte;



	INSERT INTO dwh_silver.erp_cust_az12 (
		cid,
		bdate,
		gen)

	SELECT
		CASE
			WHEN cid LIKE 'NAS%' THEN TRIM(SUBSTRING(cid, 4, LENGTH(cid))) -- Remove 'NAS' prefix and any accidental whitespace
			ELSE TRIM(cid)
		END AS cid,
		CASE
			WHEN bdate > CURDATE() THEN NULL
			ELSE bdate
		END AS bdate, -- Set future birthdates to NULL
		CASE
			WHEN UPPER(TRIM(gen)) IN ('F', 'FEMALE') THEN 'Female'
			WHEN UPPER(TRIM(gen)) IN ('M', 'MALE') THEN 'Male'
			ELSE 'n/a'
		END AS gen -- Normalize gender values and handle unknown cases
	FROM dwh_bronze.erp_cust_az12;



	INSERT INTO dwh_silver.erp_loc_a101 (
		cid,
		cntry)
		
	SELECT
		REPLACE(cid, '-', '') AS cid,
		CASE
			WHEN UPPER(TRIM(cntry)) = 'DE' THEN 'Germany'
			WHEN UPPER(TRIM(cntry)) IN ('US', 'USA') THEN 'United States'
			WHEN TRIM(cntry) = '' OR cntry IS NULL THEN 'n/a'
			ELSE TRIM(cntry)
		END AS cntry -- Normalize and Handle missing or blank country codes
	FROM dwh_bronze.erp_loc_a101;



	INSERT INTO dwh_silver.erp_px_cat_g1v2 (
		id,
		cat,
		subcat,
		maintenance)
		
	SELECT
		id,
		cat,
		subcat,
		maintenance
	FROM dwh_bronze.erp_px_cat_g1v2;
END$$
DELIMITER ;



CALL dwh_silver.load_silver_layer();
